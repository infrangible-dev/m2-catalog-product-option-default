{
    "name": "infrangible/m2-catalog-product-option-default",
    "description": "Lets you mark one value of a drop-down option as default. It is used automatically when a product is added to the cart without a choice for that option.",
    "type": "magento2-module",
    "version": "1.0.4",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Cart and checkout",
        "default value for custom options",
        "default drop-down option",
        "add to cart without option choice"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-option-default",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionDefault\\": "src"
        }
    }
}
